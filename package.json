{
  "name": "@swufefox/ak-blog",
  "version": "1.0.2",
  "type": "module",
  "license": "MIT",
  "description": "Build a bilingual static blog from a content repository with Next.js and ak-ui.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SwufeFox/ak-blog.git"
  },
  "homepage": "https://github.com/SwufeFox/ak-blog#readme",
  "bugs": {
    "url": "https://github.com/SwufeFox/ak-blog/issues"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "main": "./dist/ui/index.js",
  "types": "./dist/ui/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/ui/index.d.ts",
      "import": "./dist/ui/index.js"
    },
    "./build": {
      "types": "./dist/build/index.d.ts",
      "import": "./dist/build/index.js"
    },
    "./style.css": "./dist/style.css"
  },
  "sideEffects": ["**/*.css"],
  "bin": {
    "ak-blog": "./bin/ak-blog.mjs"
  },
  "files": [
    "dist/ui",
    "dist/build",
    "dist/site-options.js",
    "dist/site-options.d.ts",
    "dist/style.css",
    "dist/template",
    "bin",
    "docs",
    "LICENSE",
    "README.md"
  ],
  "peerDependencies": {
    "@swufefox/ak-ui-react": "^2.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "node scripts/preview.mjs",
    "lint": "eslint src",
    "build:package": "node scripts/build-package.mjs",
    "smoke:package": "node scripts/smoke-package.mjs",
    "prepack": "npm run build:package"
  },
  "dependencies": {
    "@swufefox/ak-ui-react": "^2.0.0",
    "echarts": "^6.1.0",
    "gray-matter": "^4.0.3",
    "image-size": "^2.1.0",
    "katex": "^0.19.1",
    "mermaid": "^12.3.0",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-pretty-code": "^0.14.6",
    "rehype-raw": "^7.0.0",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.2.0",
    "vfile": "^6.0.3",
    "@types/hast": "^3.0.4",
    "@types/mdast": "^4.0.4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "typescript": "^5"
  },
  "devDependencies": {
    "eslint": "^9",
    "eslint-config-next": "16.4.6"
  }
}
